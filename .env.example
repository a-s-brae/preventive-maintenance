# Neon Postgres — set automatically when you add Neon from the Vercel Marketplace.
# DATABASE_URL_UNPOOLED (direct, for migrations) is optional with other databases.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Resend (magic-link email). Create an API key at resend.com and verify your domain.
AUTH_RESEND_KEY=""
EMAIL_FROM="PM System <pm@as-plastech.com>"

# Local mode (running on your own computer, e.g. via `npm run local`): sign in
# without an email check, so Resend isn't needed. Never enabled on Vercel.
# AUTH_LOCAL_LOGIN=true
# Needed when running `next start` yourself (Vercel sets this automatically).
# AUTH_TRUST_HOST=true

# Only emails at these domains may sign in (comma-separated).
ALLOWED_EMAIL_DOMAINS="as-plastech.com"

# Optional: sign in with work email + one shared password on the sign-in page,
# instead of an emailed link — a stopgap while email isn't set up. At least 12 characters.
# TEAM_PASSWORD="belts-and-bearings-friday"

# Optional: default labor cost per hour on the Reports page (can be changed there).
# LABOR_RATE=45
