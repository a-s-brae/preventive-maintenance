# Neon Postgres — set automatically when you add Neon from the Vercel Marketplace.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Resend (magic-link email). Create an API key at resend.com and verify your domain.
AUTH_RESEND_KEY=""
EMAIL_FROM="PM System <pm@as-plastech.com>"

# Only emails at these domains may sign in (comma-separated).
ALLOWED_EMAIL_DOMAINS="as-plastech.com"
