generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: DATABASE_URL is the pooled connection, DATABASE_URL_UNPOOLED is direct
  // (used by migrations). The Vercel ↔ Neon integration sets both; with other
  // databases the Vercel build fills them in (lib/db-env.ts, scripts/vercel-build.ts).
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Maintenance domain ──────────────────────────────────────────────────────

enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum IntervalUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum WorkOrderType {
  PM // generated from a PM schedule
  REPAIR // corrective / breakdown work
  INSPECTION // ad-hoc check
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETE
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

/// How the next calendar due date is found after a PM is done.
enum ScheduleBasis {
  COMPLETION // N units after it was last done
  FIXED // on a fixed calendar (e.g. the 1st of every month), however late it was done
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Where equipment lives, as a tree: plant → area → line …
model Location {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Location[] @relation("LocationTree")
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  assets   Asset[]
  requests Request[]

  @@index([parentId])
}

/// A piece of equipment. Deliberately generic (compressor, forklift, HVAC,
/// press, …) so the system can grow from facility gear into production.
model Asset {
  id             String      @id @default(cuid())
  name           String
  assetTag       String?     @unique
  category       String?
  locationId     String?
  location       Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Parent equipment, e.g. the press a dryer belongs to.
  parentId       String?
  parent         Asset?      @relation("AssetTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Asset[]     @relation("AssetTree")
  manufacturer   String?
  model          String?
  serialNumber   String?
  status         AssetStatus @default(ACTIVE)
  /// Unit for usage-based PM, e.g. "hours", "cycles", "miles". Null = no meter.
  meterUnit      String?
  currentMeter   Float?
  meterUpdatedAt DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tasks       PmTask[]
  workOrders  WorkOrder[]
  readings    MeterReading[]
  downtimes   Downtime[]
  requests    Request[]
  attachments Attachment[]

  @@index([status])
  @@index([locationId])
  @@index([parentId])
}

/// A period when an asset was down. Open (no endedAt) while it's still down.
model Downtime {
  id             String     @id @default(cuid())
  assetId        String
  asset          Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Set to assetId while open, so an asset can only have one open downtime.
  openForAssetId String?    @unique
  startedAt      DateTime
  endedAt        DateTime?
  reason         String?
  workOrderId    String?
  workOrder      WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  requestId      String?
  request        Request?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  startedById    String?
  startedBy      User?      @relation("DowntimeStarter", fields: [startedById], references: [id], onDelete: SetNull)
  endedById      String?
  endedBy        User?      @relation("DowntimeEnder", fields: [endedById], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  @@index([assetId, startedAt])
  @@index([workOrderId])
}

/// A problem reported by anyone. A reviewer approves it into a work order or rejects it.
model Request {
  id            String        @id @default(cuid())
  /// Shown as REQ-0001.
  number        Int           @unique @default(autoincrement())
  title         String
  description   String?
  assetId       String?
  asset         Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  locationId    String?
  location      Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  priority      Priority      @default(NONE)
  /// The requester reported the equipment as down.
  assetDown     Boolean       @default(false)
  status        RequestStatus @default(PENDING)
  requestedById String?
  requestedBy   User?         @relation("RequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?         @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  /// Why it was rejected (or a note on approval).
  reviewNote    String?
  workOrderId   String?       @unique
  workOrder     WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  downtimes Downtime[]

  @@index([status, createdAt])
}

/// A recurring PM schedule on one asset. When it comes due it creates a work
/// order. Due by calendar, by usage, or both (whichever comes first).
model PmTask {
  id                  String             @id @default(cuid())
  assetId             String
  asset               Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title               String
  instructions        String?
  /// ChecklistItem[] — see lib/checklist.ts
  checklist           Json               @default("[]")
  /// When set, the checklist is a copy of this template's and is kept in step with it.
  checklistTemplateId String?
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  calendarEvery       Int?
  calendarUnit        IntervalUnit?
  usageEvery          Float?
  scheduleBasis       ScheduleBasis      @default(COMPLETION)
  /// First calendar due date.
  startDate           DateTime
  /// Meter baseline until the task is first completed.
  startMeter          Float?
  lastDoneAt          DateTime?
  lastDoneMeter       Float?
  /// FIXED schedules: index of the next occurrence (startDate + n × interval).
  fixedCycle          Int                @default(0)
  /// Days before the calendar due date that the work order is created.
  dueSoonDays         Int                @default(7)
  estimatedMinutes    Int?
  priority            Priority           @default(NONE)
  defaultAssigneeId   String?
  defaultAssignee     User?              @relation("PmDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workOrders WorkOrder[]

  @@index([assetId])
  @@index([checklistTemplateId])
}

model WorkOrder {
  id               String          @id @default(cuid())
  /// Human-friendly number, shown as WO-0001.
  number           Int             @unique @default(autoincrement())
  type             WorkOrderType
  status           WorkOrderStatus @default(OPEN)
  priority         Priority        @default(NONE)
  title            String
  description      String?
  assetId          String
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  pmTaskId         String?
  pmTask           PmTask?         @relation(fields: [pmTaskId], references: [id], onDelete: SetNull)
  /// Set to pmTaskId while this PM work order is open, so a schedule can only
  /// ever have one open work order.
  openForTaskId    String?         @unique
  /// FIXED schedules: which occurrence of the schedule this is.
  cycle            Int?
  dueDate          DateTime?
  /// Usage-based PM: meter reading it's due at.
  dueMeter         Float?
  /// ChecklistItem[] copied from the PM when the work order is created.
  checklist        Json            @default("[]")
  /// ChecklistResult[] filled in on completion.
  checklistResults Json?
  assignedToId     String?
  assignedTo       User?           @relation("WorkOrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?           @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  startedAt        DateTime?
  completedAt      DateTime?
  completedById    String?
  completedBy      User?           @relation("WorkOrderCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  meterReading     Float?
  completionNotes  String?
  /// Repair work order raised because this one's inspection found problems.
  followUpOfId     String?
  followUpOf       WorkOrder?      @relation("FollowUp", fields: [followUpOfId], references: [id], onDelete: SetNull)
  followUps        WorkOrder[]     @relation("FollowUp")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  request     Request?
  downtimes   Downtime[]
  partUsages  PartUsage[]
  labor       LaborEntry[]
  attachments Attachment[]

  @@index([status, dueDate])
  @@index([assetId, completedAt])
  @@index([pmTaskId])
  @@index([assignedToId])
  @@index([followUpOfId])
}

model MeterReading {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  value        Float
  recordedAt   DateTime @default(now())
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([assetId, recordedAt])
}

// ─── Parts, labor, files ─────────────────────────────────────────────────────

enum StockReason {
  RESTOCK // received stock
  USED // used on a work order
  RETURNED // taken back off a work order
  ADJUST // corrected after a count
}

/// A spare part or consumable kept in stock.
model Part {
  id              String   @id @default(cuid())
  name            String
  partNumber      String?  @unique
  description     String?
  /// Counting unit: ea, ft, qt, box…
  unit            String   @default("ea")
  quantity        Float    @default(0)
  /// At or below this, the part shows as low stock.
  minQuantity     Float?
  unitCost        Float?
  /// Where it's kept, e.g. "Crib A, bin 12".
  storageLocation String?
  vendor          String?
  notes           String?
  /// Inactive parts are hidden from pickers but keep their history.
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usages       PartUsage[]
  transactions StockTransaction[]

  @@index([active, name])
}

/// Parts used on a work order. Using parts takes them out of stock.
model PartUsage {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity    Float
  /// Unit cost when it was used (prices change).
  unitCost    Float?
  usedById    String?
  usedBy      User?     @relation(fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@index([partId])
}

/// Every change to a part's stock, for the history.
model StockTransaction {
  id            String      @id @default(cuid())
  partId        String
  part          Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  change        Float
  quantityAfter Float
  reason        StockReason
  unitCost      Float?
  workOrderId   String?
  note          String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([partId, createdAt])
}

/// Time someone spent on a work order. A running timer has no endedAt.
model LaborEntry {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  startedAt   DateTime
  endedAt     DateTime?
  minutes     Int?
  note        String?
  /// "<userId>:<workOrderId>" while the timer runs: one running timer per person per work order.
  runningKey  String?   @unique
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
}

/// A photo or document on a work order or an asset. The bytes live in AttachmentData.
model Attachment {
  id           String          @id @default(cuid())
  workOrderId  String?
  workOrder    WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  assetId      String?
  asset        Asset?          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  data         AttachmentData?

  @@index([workOrderId])
  @@index([assetId])
}

model AttachmentData {
  attachmentId String     @id
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  bytes        Bytes
}

// ─── Auth.js (magic-link sign-in) ────────────────────────────────────────────

enum Role {
  ADMIN // supervisors: approve requests, manage PM schedules, assets, parts and people
  TECH // maintenance: do and record the work
  REQUESTER // everyone else: report problems, follow their requests
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(REQUESTER)
  /// Deactivated users can't sign in.
  active        Boolean   @default(true)
  /// Gets the daily overdue / due-today email.
  emailDigest   Boolean   @default(true)
  /// The role they've had the welcome and tour for; shown again when their role changes.
  welcomedAs    Role?
  /// The role they hid the dashboard's getting-started card as.
  guideHiddenAs Role?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  password Password?
  readings MeterReading[]

  assignedWorkOrders  WorkOrder[]        @relation("WorkOrderAssignee")
  createdWorkOrders   WorkOrder[]        @relation("WorkOrderCreator")
  completedWorkOrders WorkOrder[]        @relation("WorkOrderCompleter")
  defaultForPmTasks   PmTask[]           @relation("PmDefaultAssignee")
  requests            Request[]          @relation("RequestRequester")
  reviewedRequests    Request[]          @relation("RequestReviewer")
  startedDowntimes    Downtime[]         @relation("DowntimeStarter")
  endedDowntimes      Downtime[]         @relation("DowntimeEnder")
  partUsages          PartUsage[]
  stockTransactions   StockTransaction[]
  labor               LaborEntry[]
  attachments         Attachment[]
  notifications       Notification[]
}

/// A person's own sign-in password, as a scrypt hash (lib/passwords.ts). Kept
/// apart from User so loading a user (and handing it to a page) never loads it.
model Password {
  userId    String   @id
  hash      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Checklist templates, notifications ──────────────────────────────────────

/// A reusable checklist, e.g. one forklift inspection used by every forklift.
model ChecklistTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// ChecklistItem[] — see lib/checklist.ts
  items       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks PmTask[]
}

/// An in-app notice for one person (the bell).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  /// Page it opens, e.g. /work-orders/<id>.
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
